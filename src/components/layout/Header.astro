---
import ThemeToggle from "../react/ThemeToggle";

const navItems = [
  { name: "Proyectos", href: "#proyectos" },
  { name: "Sobre mí", href: "#sobre-mi" },
];
---

<header
  class="sticky top-0 z-50 w-full bg-neutral-50/[.92] backdrop-blur-sm dark:bg-neutral-950/[.92] border-b border-neutral-200/50 dark:border-neutral-800/50"
>
  <div
    class="mx-auto max-w-[1440px] px-4 sm:px-8 lg:px-16 flex items-center justify-between h-[90px]"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3">
      <div
        class="w-11 h-11 bg-brand-500 rounded-[10px] flex items-center justify-center text-white font-extrabold text-[17px] leading-none flex-shrink-0"
      >
        ST
      </div>
      <span class="font-semibold text-sm text-neutral-900 dark:text-neutral-50"
        >Santiago Trigo</span
      >
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-9">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="font-medium text-[15px] text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-50 transition-colors"
          >
            {item.name}
          </a>
        ))
      }
      <ThemeToggle client:load />
      <a
        href="mailto:santiagotrigoporres@gmail.com"
        class="px-[22px] py-[11px] bg-neutral-900 text-white text-sm font-semibold rounded-full hover:bg-neutral-800 dark:bg-neutral-50 dark:text-neutral-900 dark:hover:bg-neutral-200 transition-colors"
      >
        Hablemos
      </a>
    </nav>

    <!-- Mobile controls -->
    <div class="flex md:hidden items-center gap-2">
      <ThemeToggle client:load />
      <button
        id="mobile-menu-btn"
        aria-label="Abrir menú"
        aria-expanded="false"
        class="p-2 text-neutral-700 dark:text-neutral-400"
      >
        <svg
          id="menu-open"
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="menu-close"
          class="w-6 h-6 hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-neutral-200 dark:border-neutral-800 px-4 pb-4 pt-2"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="block py-2.5 text-base font-medium text-neutral-700 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-50"
        >
          {item.name}
        </a>
      ))
    }
    <a
      href="mailto:santi@trigo.dev"
      class="inline-block mt-3 px-[22px] py-[11px] bg-neutral-900 text-white text-sm font-semibold rounded-full dark:bg-neutral-50 dark:text-neutral-900"
    >
      Hablemos
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-open");
  const closeIcon = document.getElementById("menu-close");

  btn?.addEventListener("click", () => {
    const expanded = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!expanded));
    menu?.classList.toggle("hidden");
    openIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      openIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
      btn?.setAttribute("aria-expanded", "false");
    });
  });
</script>
