---
const currentYear = new Date().getFullYear();

const links = [
  { name: "LinkedIn", href: "https://linkedin.com/in/santiagotrigoporres" },
  { name: "GitHub", href: "https://github.com/trigoporres" },
  { name: "santiagotrigoporres@gmail.com", href: "mailto:santiagotrigoporres@gmail.com" },
];
---

<footer class="border-t border-neutral-200 dark:border-neutral-800">
  <div class="mx-auto max-w-[1440px] px-4 sm:px-8 lg:px-16 py-[30px] flex flex-col sm:flex-row items-center justify-between gap-4 font-medium text-[13px] text-neutral-500 dark:text-neutral-500">
    <span>© {currentYear} Santiago Trigo</span>
    <div class="flex gap-5">
      {
        links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="hover:text-neutral-900 dark:hover:text-neutral-50 transition-colors"
          >
            {link.name}
          </a>
        ))
      }
    </div>
  </div>
</footer>
