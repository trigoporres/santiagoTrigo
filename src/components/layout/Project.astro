---
interface Props {
  title: string;
  description: string;
  url: string;
  github: string;
  storybook?: string;
  stack: string[];
}

const { title, description, url, github, storybook, stack } = Astro.props;
---

<div
  class="block border border-neutral-200 dark:border-neutral-800 p-6 rounded-lg"
>
  <h3 class="text-2xl font-bold mb-4">
    {title}
  </h3>
  <p class="text-neutral-600 dark:text-neutral-400 mb-4 line-clamp-2">
    {description}
  </p>
  <div class="flex flex-wrap gap-2 mt-3">
    {
      stack.map((tecnology) => (
        <span class="border border-neutral-300 dark:border-neutral-700 text-xs font-medium py-0.5 px-2 rounded-full text-neutral-700 dark:text-neutral-300 bg-white dark:bg-neutral-800 shadow-sm">
          {tecnology}
        </span>
      ))
    }
  </div>
  <div class="flex justify-between items-center mt-4">
    <div class="flex gap-3">
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-brand-600 dark:text-brand-400 border border-brand-600 dark:border-brand-500 font-medium
                py-1 px-3
                rounded-lg
                hover:bg-brand-50 dark:hover:bg-brand-900/20 transition duration-150
                focus:outline-none focus:ring-2 focus:ring-brand-500"
      >
        GitHub
      </a>

      {
        storybook && (
          <a
            href={storybook}
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-600 dark:text-brand-400
                    border border-brand-600 dark:border-brand-500
                    font-medium
                    py-1 px-3
                    rounded-lg
                    hover:bg-brand-50 dark:hover:bg-brand-900/20
                    transition duration-150
                    focus:outline-none focus:ring-2 focus:ring-brand-500"
          >
            Storybook
          </a>
        )
      }
    </div>
  </div>
</div>
