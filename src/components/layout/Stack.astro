---
const techs = [
  "React",
  "TypeScript",
  "Testing (Vitest / Cypress / Playwright)",
  "JavaScript",
  "Visualización de datos",
];
---

<section class="px-4 sm:px-8 lg:px-16 pb-24">
  <div class="mx-auto max-w-[1440px]">
    <h2
      class="mb-7 font-bold text-[22px] text-neutral-900 dark:text-neutral-50"
    >
      Con qué trabajo
    </h2>
    <div class="flex gap-3 flex-wrap">
      {
        techs.map((tech) => (
          <span class="font-semibold text-[15px] text-neutral-800 dark:text-neutral-200 bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 px-5 py-2.5 rounded-full">
            {tech}
          </span>
        ))
      }
    </div>
  </div>
</section>
