---
import Logo from "./Logo.astro";
---

<main class="container mx-auto flex flex-1 flex-col px-4 sm:px-6 lg:px-8">
  <section class="flex flex-1 flex-col justify-center py-20">
    <div class="max-w-3xl">
      <div class="mb-6">
        <Logo />
      </div>

      <h1
        class="mb-4 text-4xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50 md:text-5xl"
      >
        Santiago Trigo
      </h1>

      <!-- Rol -->
      <p class="mb-3 text-xl font-medium text-neutral-600 dark:text-neutral-300">
        Senior Frontend Developer · Testing & IA
      </p>

      <!-- Tagline -->
      <p class="mb-6 text-xl text-neutral-600 dark:text-neutral-300">
        Frontend con criterio: tests que dan confianza, IA que multiplica.
      </p>

      <!-- Bio -->
      <p class="mb-8 max-w-2xl text-lg text-neutral-600 dark:text-neutral-400">
        7 años construyendo con React y TypeScript. Obsesionado con el testing
        bien hecho y con integrar IA donde realmente suma. Diseño sistemas
        testeables, mantenibles y pensados para durar.
      </p>

      <!-- Stack -->
      <div
        class="mb-10 flex flex-wrap gap-2 text-sm text-neutral-500 dark:text-neutral-500"
      >
        <span
          class="border border-neutral-300 dark:border-neutral-700 text-lg font-medium py-0.5 px-4 rounded-full text-neutral-700 dark:text-neutral-300 bg-white dark:bg-neutral-800 shadow-sm"
        >
          React
        </span>
        <span
          class="border border-neutral-300 dark:border-neutral-700 text-lg font-medium py-0.5 px-4 rounded-full text-neutral-700 dark:text-neutral-300 bg-white dark:bg-neutral-800 shadow-sm"
        >
          TypeScript
        </span>
        <span
          class="border border-neutral-300 dark:border-neutral-700 text-lg font-medium py-0.5 px-4 rounded-full text-neutral-700 dark:text-neutral-300 bg-white dark:bg-neutral-800 shadow-sm"
        >
          Vite
        </span>
        <span
          class="border border-neutral-300 dark:border-neutral-700 text-lg font-medium py-0.5 px-4 rounded-full text-neutral-700 dark:text-neutral-300 bg-white dark:bg-neutral-800 shadow-sm"
        >
          7+ años
        </span>
      </div>
    </div>
  </section>
</main>
