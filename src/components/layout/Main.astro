---
import Logo from "./Logo.astro";
---

<main class="container mx-auto flex flex-1 flex-col px-4 sm:px-6 lg:px-8">
  <section class="flex flex-1 flex-col justify-center py-20">
    <div class="max-w-3xl">
      <div class="mb-6">
        <Logo />
      </div>

      <h1
        class="mb-4 text-4xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50 md:text-5xl"
      >
        Santiago Trigo
      </h1>

      <!-- Tagline -->
      <p class="mb-6 text-xl text-neutral-600 dark:text-neutral-300">
        Frontend Developer
      </p>

      <!-- Descripción -->
      <p class="mb-8 max-w-2xl text-lg text-neutral-600 dark:text-neutral-400">
        Construyo interfaces web con atención al detalle y creatividad técnica.
        Meticuloso, creativo, investigador.
      </p>

      <!-- Stack -->
      <div
        class="mb-10 flex flex-wrap gap-2 text-sm text-neutral-500 dark:text-neutral-500"
      >
        <span>React</span>
        <span>•</span>
        <span>TypeScript</span>
        <span>•</span>
        <span>Vite</span>
        <span>•</span>
        <span>7+ años</span>
      </div>
    </div>
  </section>
</main>
