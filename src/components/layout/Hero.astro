---

<section
  class="px-4 sm:px-8 lg:px-16 pt-[72px] pb-[100px] relative overflow-hidden"
>
  <div class="mx-auto max-w-[1440px] relative">
    <!-- Watermark -->
    <div
      class="absolute right-[-60px] top-[-70px] font-extrabold leading-none text-brand-100 dark:text-neutral-800 pointer-events-none select-none tracking-[-0.04em] z-0"
      style="font-size: clamp(200px, 32vw, 460px)"
      aria-hidden="true"
    >
      ST
    </div>

    <div class="relative z-10">
      <p
        class="font-semibold text-[13px] text-brand-500 tracking-[0.04em] uppercase mb-[22px]"
      >
        Santiago Trigo — Frontend senior
      </p>
      <h1
        class="m-0 mb-7 font-extrabold text-[clamp(40px,6vw,76px)] leading-[1.1] text-neutral-900 dark:text-neutral-50 tracking-[-0.02em] max-w-[700px]"
      >
        Frontend senior.<br />React, testing y<br />visualización de datos.
      </h1>
      <p
        class="m-0 mb-10 text-[clamp(17px,2vw,20px)] leading-[1.55] text-neutral-700 dark:text-neutral-400 max-w-[560px]"
      >
        7+ años construyendo sistemas de componentes y visualizaciones de datos.
      </p>
      <div class="flex gap-4 items-center flex-wrap">
        <a
          href="#proyectos"
          class="px-[30px] py-4 bg-brand-500 text-white font-bold text-[15px] rounded-full hover:bg-brand-600 transition-colors"
        >
          Ver proyectos
        </a>
        <a
          href="/cv-santiago-trigo.pdf"
          download
          class="px-[30px] py-4 border border-neutral-200 dark:border-neutral-700 text-neutral-800 dark:text-neutral-200 font-semibold text-[15px] rounded-full hover:border-neutral-400 dark:hover:border-neutral-500 transition-colors"
        >
          Descargar CV
        </a>
      </div>
    </div>
  </div>
</section>
