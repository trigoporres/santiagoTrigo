---
import Header from "../components/layout/Header.astro";
import Project from "../components/layout/Project.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    type: "library",
    title: "genesys-ui",
    description: "Librería de componentes para React.",
    url: "/projects/genesys-ui",
    github: "https://github.com/DevoInc/genesys-ui",
    storybook: "https://devoinc.github.io/genesys-ui",
    stack: [
      "React",
      "TypeScript",
      "Storybook",
      "Vite",
      "Vitest",
      "npm workspaces",
    ],
  },
  {
    type: "library",
    title: "genesys-ui-form-builder",
    description:
      "Un constructor de formularios basado en un modelo de campos descriptivo.",
    url: "/projects/genesys-ui-form-builder",
    github: "https://github.com/DevoInc/genesys-ui-form-builder",
    storybook: "https://devoinc.github.io/genesys-ui-form-builder",
    stack: ["React", "TypeScript", "Genesys UI", "Storybook"],
  },
  {
    type: "library",
    title: "grid-layout",
    description:
      "Un diseño de cuadrícula arrastrable y redimensionable con puntos de ruptura responsivos, para React.",
    url: "/projects/grid-layout",
    github: "https://github.com/DevoInc/grid-layout",
    storybook: "https://devoinc.github.io/grid-layout/",
    stack: ["React", "TypeScript", "Vitest", "Storybook"],
  },
  {
    type: "tool",
    title: "holo",
    description:
      "Un herramienta para crear estructuras de datos basadas en faker y chance.",
    url: "/projects/holo",
    github: "https://github.com/DevoInc/holo",
    stack: ["TypeScript", "Faker", "Chance", "Vite"],
  },
];
---

<BaseLayout
  title="Proyectos - Santiago Trigo"
  description="Proyectos personales."
>
  <Header />

  <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-4xl font-bold mb-8">Proyectos</h1>
    <h2 class="text-2xl font-bold mb-4">Librerías</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        projects
          .filter((project) => project.type === "library")
          .map((project) => (
            <Project
              title={project.title}
              description={project.description}
              url={project.url}
              github={project.github}
              storybook={project.storybook}
              stack={project.stack}
            />
          ))
      }
    </div>
    <h2 class="text-2xl font-bold mb-4 mt-12">Herramientas</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        projects
          .filter((project) => project.type === "tool")
          .map((project) => (
            <Project
              title={project.title}
              description={project.description}
              url={project.url}
              github={project.github}
              stack={project.stack}
            />
          ))
      }
    </div>
  </main>
</BaseLayout>
