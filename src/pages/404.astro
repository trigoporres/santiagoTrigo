---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
---

<BaseLayout title="404 - Página no encontrada">
  <Header />
  <main class="flex flex-1 flex-col items-center justify-center min-h-[60vh] px-4 text-center">
    <h1 class="mb-4 text-9xl font-extrabold text-brand-500">404</h1>
    <h2 class="mb-6 text-2xl font-bold text-neutral-900 dark:text-neutral-50">
      Página no encontrada
    </h2>
    <p class="mb-8 max-w-md text-neutral-600 dark:text-neutral-400">
      La página que buscas no existe o ha sido movida.
    </p>
    <a
      href="/"
      class="px-6 py-3 bg-brand-500 text-white text-sm font-semibold rounded-full hover:bg-brand-600 transition-colors"
    >
      Volver al inicio
    </a>
  </main>
</BaseLayout>
